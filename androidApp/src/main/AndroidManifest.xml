<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Daily Google Drive backup. Sentry's manifest already merged this in; declared here so
         the backup does not depend on a crash reporter's manifest to reach the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- FEAT-05: Settings → Labels & stickers writes NFC stickers (reader mode). A normal
         permission: granted at install, no prompt. NFC stays optional so phones without it
         still install the app; the write action is hidden there. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:name=".OstomateApp"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Disable Sentry's ContentProvider auto-init; we initialize manually (opt-in). -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />
        <!-- SentryPerformanceProvider ignores auto-init and starts native threads unconditionally;
             its libsentry.so crashes in sentry_add_breadcrumb (SIGSEGV on SentryExecutorS). -->
        <provider
            android:name="io.sentry.android.core.SentryPerformanceProvider"
            android:authorities="${applicationId}.SentryPerformanceProvider"
            android:enabled="false"
            tools:node="merge" />
        <activity
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ostomate" android:host="log" />
            </intent-filter>
            <!-- FEAT-04: an NFC sticker holding the same link. Without this, Android has no app
                 for the tag and shows its own "new tag" screen instead of opening Ostomate. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="ostomate" android:host="log" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".OstomateWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ostomate_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
