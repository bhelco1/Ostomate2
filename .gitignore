# Android signing keys — never commit these
*.keystore
*.jks
*.p12

# iOS secrets — the Sentry DSN lives in Secrets.xcconfig (gitignored), which
# Config.xcconfig includes and Info.plist exposes as SentryDSN. That is the path the
# Xcode project and CI use. A local-only Secrets.swift also exists on the dev Mac; it is
# NOT referenced by project.pbxproj (so a fresh clone still builds without it), but it
# holds a secret and must never be committed.
iosApp/Configuration/Secrets.xcconfig
iosApp/iosApp/Secrets.swift

# Generated by scripts/run_android_e2e.sh — failure evidence, never source
e2e-diagnostics/

*.iml
.kotlin
.gradle
**/build/
xcuserdata
!src/**/build/
local.properties
.idea
.DS_Store
captures
.externalNativeBuild
.cxx
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings
